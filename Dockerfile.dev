FROM php:8.5-apache

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libicu-dev libzip-dev libonig-dev libpng-dev zip unzip

# Install PHP extensions
RUN docker-php-ext-install \
    intl mbstring gd mysqli pdo pdo_mysql zip

# Install PCOV & Redis
RUN pecl install pcov redis \
    && docker-php-ext-enable pcov redis

# Configure PCOV
RUN echo "pcov.enabled=1" >>/usr/local/etc/php/conf.d/pcov.ini \
    && echo "pcov.directory=/var/www/html" >>/usr/local/etc/php/conf.d/pcov.ini

# Activate Apache Rewrite Mod
RUN a2enmod rewrite

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set Work Directory
WORKDIR /var/www/html

# Apache Configuration
ENV APACHE_DOCUMENT_ROOT=/var/www/html/public
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf
RUN sed -ri -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf

CMD ["apache2-foreground"]
